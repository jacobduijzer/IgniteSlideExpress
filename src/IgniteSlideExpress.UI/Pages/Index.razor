@page "/"
@using IgniteSlideExpress.UI.ViewModels
@using System.ComponentModel
@using IgniteSlideExpress.Core

@inject SessionViewModel SessionViewModel

@implements IDisposable

<PageTitle>Ignite Slide Express</PageTitle>

@{
    var talks = SessionViewModel.Session.Talks
        .Where(value => value is not null)
        .Select((value, i) => new { i, value = value! })
        .ToList();
}

<div class="home-page">
    <section class="home-panel talk-list-panel">
        <div class="section-heading">
            <div>
                <h2>Talks</h2>
            </div>
            <div class="section-heading-actions">
                <a class="btn btn-outline-primary btn-sm" href="#add-talk">+ New Talk</a>
                <span class="talk-count">@talks.Count talks</span>
            </div>
        </div>

        @if (talks.Count == 0)
        {
            <div class="empty-state">
                <h3>No talks yet</h3>
                <p>Add the first PDF deck below to build this session.</p>
            </div>
        }
        else
        {
            <div class="talk-table-wrap">
                <table class="table talk-table">
                    <colgroup>
                        <col class="talk-title-column" />
                        <col class="talk-speaker-column" />
                        <col class="talk-slides-column" />
                        <col class="talk-actions-column" />
                    </colgroup>
                    <thead>
                    <tr>
                        <th>Title</th>
                        <th>Speaker</th>
                        <th>Slides</th>
                        <th class="talk-actions-heading">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var talk in talks)
                    {
                        <tr>
                            @if (_editingTalkId == talk.value.Id)
                            {
                                <td>
                                    <input class="form-control" aria-label="Title" @bind="_editTalk.Title" />
                                </td>
                                <td>
                                    <input class="form-control" aria-label="Speaker" @bind="_editTalk.Speaker" />
                                </td>
                                <td>@talk.value.NumberOfSlides</td>
                                <td>
                                    <div class="talk-actions">
                                        <button class="btn btn-primary btn-sm" disabled="@IsEditDisabled" @onclick="SaveEdit">Save</button>
                                        <button class="btn btn-outline-secondary btn-sm" @onclick="CancelEdit">Cancel</button>
                                    </div>
                                </td>
                            }
                            else
                            {
                                <td>
                                    <NavLink class="talk-title-link" href="@($"presentation/{talk.value.Id}")" target="_blank">
                                        @talk.value.Title
                                    </NavLink>
                                </td>
                                <td>@talk.value.Speaker</td>
                                <td>@talk.value.NumberOfSlides</td>
                                <td>
                                    <div class="talk-actions">
                                        <button class="btn btn-outline-secondary btn-sm"
                                                title="Move up"
                                                disabled="@(talk.i == 0)"
                                                @onclick="() => MoveUp(talk.value.Id)">Up</button>
                                        <button class="btn btn-outline-secondary btn-sm"
                                                title="Move down"
                                                disabled="@(talk.i == talks.Count - 1)"
                                                @onclick="() => MoveDown(talk.value.Id)">Down</button>
                                        <a class="btn btn-info btn-sm text-white" href="@($"presentation/{talk.value.Id}")" target="_blank">Open</a>
                                        <button class="btn btn-warning btn-sm" @onclick="() => StartEdit(talk.value)">Edit</button>
                                        <button class="btn btn-danger btn-sm" @onclick="() => Delete(talk.value.Id)">Delete</button>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="home-panel add-talk-panel" id="add-talk">
        <div class="section-heading">
            <div>
                <h2>Add talk</h2>
            </div>
        </div>
        <EditForm Model=@_newTalk OnSubmit="FormSubmitted">
            <div class="add-talk-form">
                <label>
                    <span>Topic</span>
                    <InputText class="form-control" @bind-Value="_newTalk.Title" />
                </label>
                <label>
                    <span>Speaker</span>
                    <InputText class="form-control" @bind-Value="_newTalk.Speaker" />
                </label>
                <label>
                    <span>PDF deck</span>
                    <InputFile class="form-control" OnChange="@LoadFiles" accept="application/pdf" />
                </label>
                <button type="submit" class="btn btn-primary" disabled="@IsAddDisabled">Add talk</button>
            </div>
        </EditForm>
    </section>
</div>

@code {

    private readonly TalkDto _newTalk = new();
    private readonly TalkDto _editTalk = new();
    private Guid? _editingTalkId;
    private bool _hasSelectedFiles;

    private bool IsAddDisabled =>
        !_hasSelectedFiles ||
        string.IsNullOrWhiteSpace(_newTalk.Title) ||
        string.IsNullOrWhiteSpace(_newTalk.Speaker);

    private bool IsEditDisabled =>
        string.IsNullOrWhiteSpace(_editTalk.Title) ||
        string.IsNullOrWhiteSpace(_editTalk.Speaker);
    
    protected override async Task OnInitializedAsync()
    {
        SessionViewModel.PropertyChanged += SessionViewModelOnPropertyChanged;
        await SessionViewModel.LoadSession();
        
        await base.OnInitializedAsync();
    }

    private async void SessionViewModelOnPropertyChanged(object? sender, PropertyChangedEventArgs e) =>
        await InvokeAsync(StateHasChanged);

    private void LoadFiles(InputFileChangeEventArgs e)
    {
        SessionViewModel.AddFiles(e.GetMultipleFiles().ToList());
        _hasSelectedFiles = true;
    }

    private async Task FormSubmitted()
    {
        if (IsAddDisabled)
            return;

        await SessionViewModel.AddTalk(_newTalk.Title.Trim(), _newTalk.Speaker.Trim());
        _newTalk.Title = string.Empty;
        _newTalk.Speaker = string.Empty;
        _hasSelectedFiles = false;
    }

    private void StartEdit(Talk talk)
    {
        _editingTalkId = talk.Id;
        _editTalk.Title = talk.Title;
        _editTalk.Speaker = talk.Speaker;
    }

    private void CancelEdit()
    {
        _editingTalkId = null;
        _editTalk.Title = string.Empty;
        _editTalk.Speaker = string.Empty;
    }

    private async Task SaveEdit()
    {
        if (_editingTalkId is null || IsEditDisabled)
            return;

        await SessionViewModel.UpdateTalk(_editingTalkId.Value, _editTalk.Title.Trim(), _editTalk.Speaker.Trim());
        CancelEdit();
    }
    
    private async Task MoveUp(Guid talkId) =>
        await SessionViewModel.ChangeTalkPosition(Direction.Up, talkId);
    
    private async Task MoveDown(Guid talkId) =>
        await SessionViewModel.ChangeTalkPosition(Direction.Down, talkId);

    private async Task Delete(Guid talkId) =>
        await SessionViewModel.DeleteTalk(talkId);
   
    public void Dispose() =>
        SessionViewModel.PropertyChanged -= SessionViewModelOnPropertyChanged;
}
